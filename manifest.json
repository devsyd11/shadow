{
  "manifest_version": 3,
  "name": "Shadow",
  "version": "1.0.0",
  "description": "Shadow — capture and manage saved logins, passwords, and cookies from any site.",
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "shadow_icon.png",
    "48": "shadow_icon.png",
    "128": "shadow_icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-credentials": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open Shadow credentials page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
