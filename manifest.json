{
  "manifest_version": 3,
  "name": "Login Credentials Saver",
  "version": "1.0.0",
  "description": "Saves usernames and passwords from login forms so you can retrieve them anytime.",
  "permissions": [
    "storage",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "shadow_icon.png",
      "48": "shadow_icon.png",
      "128": "shadow_icon.png"
    },
    "default_title": "Open saved credentials"
  },
  "icons": {
    "16": "shadow_icon.png",
    "48": "shadow_icon.png",
    "128": "shadow_icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-credentials": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open saved credentials page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
